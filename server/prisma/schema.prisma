generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  email     String    @unique
  password  String
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile?
  sections  Section[]
  tasks     Task[]
  dynamics  Dynamic[]
  projects  Project[]
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  nickname      String   @default("")
  slogan        String   @default("")
  bio           String   @default("")
  themeColor    String   @default("#3b82f6")
  avatar        String   @default("")
  socialLinks   String   @default("[]")
  educations    String   @default("[]")
  workExperiences String @default("[]")
  honors        String   @default("[]")
  skills        String   @default("[]")
  footer        String   @default("")
  copyright     String   @default("")
  user          User     @relation(fields: [userId], references: [id])
}

model Section {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  parentId    String?
  title       String
  description String   @default("")
  dueDate     DateTime?
  priority    String   @default("normal")
  status      String   @default("todo")
  progress    Int      @default(0)
  isPublic    Boolean  @default(false)
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id])
  children    Task[]   @relation("TaskHierarchy")

  @@index([userId])
  @@index([parentId])
}

model Dynamic {
  id          String   @id @default(uuid())
  userId      String
  title       String
  content     String
  summary     String   @default("")
  tags        String[] @default([])
  isPublic    Boolean  @default(true)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isPublic])
}

model Project {
  id            String   @id @default(uuid())
  userId        String
  name          String
  description   String   @default("")
  summary       String   @default("")
  techStack     String[] @default([])
  achievements  String   @default("")
  externalLink  String   @default("")
  coverImage    String   @default("")
  completionDate DateTime?
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}
